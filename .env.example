# ==============================================================================
# InternFlow Environment Variables Configuration Template
# Copy this file to .env in your root directory or AI/.env for local development.
# DO NOT COMMIT SENSITIVE VALUES OR ACTUAL KEYS TO VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# AI & Search Providers
# ------------------------------------------------------------------------------
# Google Gemini API Key for structured internship data extraction
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model name (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Tavily Search API Key for searching internship openings across company portals
TAVILY_API_KEY=your_tavily_api_key_here

# ------------------------------------------------------------------------------
# Email Automation (SMTP)
# ------------------------------------------------------------------------------
# Sender email address (e.g. your Gmail address)
EMAIL_ADDRESS=your_email@gmail.com

# Email app password (for Gmail, generate a 16-character App Password)
EMAIL_PASSWORD=your_16_character_app_password

# SMTP host and port
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# ------------------------------------------------------------------------------
# Backend & Automation Coordination
# ------------------------------------------------------------------------------
# URL of the hosted Render backend (e.g. https://intern-flow-ckh9.onrender.com)
RENDER_BACKEND_URL=https://intern-flow-ckh9.onrender.com

# Shared secret token securing the /automation/students and /automation/email-sent endpoints
AUTOMATION_TOKEN=your_secure_automation_token_here

# ------------------------------------------------------------------------------
# Database Settings
# ------------------------------------------------------------------------------
# Optional: Absolute or relative path to the SQLite database file
# If unset, defaults to internflow.db in the project root directory
DATABASE_PATH=internflow.db

# ------------------------------------------------------------------------------
# Safe Testing Mode
# ------------------------------------------------------------------------------
# When AUTOMATION_TEST_MODE=true, emails are only sent to TEST_EMAIL_RECIPIENT
# Real student emails are never messaged.
AUTOMATION_TEST_MODE=false
TEST_EMAIL_RECIPIENT=your_test_email@example.com

